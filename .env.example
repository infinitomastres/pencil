# Copy to .env and fill in. .env is gitignored.

# Pencil portal credentials (https://familias.pencilapp.net)
PENCIL_EMAIL=you@example.com
PENCIL_PASSWORD=

# Google destinations the `sync` step writes into.
# DRIVE_FOLDER_ID: the id from the Drive folder URL
#   (https://drive.google.com/drive/folders/<THIS_PART>)
# CALENDAR_ID: usually an email-shaped string; "primary" works for your main calendar.
DRIVE_FOLDER_ID=
CALENDAR_ID=primary

# IANA timezone for event timestamps. Defaults to Europe/Madrid if unset.
TIMEZONE=Europe/Madrid
